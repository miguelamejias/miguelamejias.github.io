---
// Feature Cards grid Section
// ------------
// Description: A grid of cards with feature information in a 4 column layout.

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import Card from '../../ui/cards/FeatureCard.astro'

// Content
// - Cards
import feature01 from '../../../assets/cards/feature-01.svg'
import feature02 from '../../../assets/cards/feature-02.svg'
import feature03 from '../../../assets/cards/feature-03.svg'
import feature04 from '../../../assets/cards/feature-04.svg'
import feature05 from '../../../assets/cards/feature-05.svg'
---

<Section id="features">
	<Row>
		<Col span="12" align="center" classes="mb-12 max-w-4xl mx-auto">
			<h2 class="text-pretty">Misalignment is <strong class="text-accent">costing you money</strong></h2>
			<p class="pb-0 text-lg font-mono">
				Most technology problems are not technical. They are failures in communication, alignment, and decision-making. Projects don't fail in execution. They fail in definition.
			</p>
		</Col>
	</Row>
	<Row>
		<Col span="4">
			<Card
				title="The Costly Mistake"
				subtitle="Focusing on shipping features instead of focusing on business outcomes. If business and technology are not aligned, you are losing money."
				image={feature01}
				link="/blog"
			/>
		</Col>
		<Col span="4" classes="flex flex-col gap-6">
			<Card
				title="The Translator Role"
				subtitle="Miguel translates technical complexity into clear business decisions, helping organizations avoid costly mistakes."
				image={feature02}
				link="/about"
			/>
			<Card
				title="Structural Clarity"
				subtitle="Re-thinking systems and pipelines through DevSecOps and backend automation to ensure security first."
				image={feature03}
				link="/about"
			/>
		</Col>
		<Col span="4" classes="flex flex-col gap-6">
			<Card
				title="Automation Expert"
				subtitle="Leveraging Rust and Python to build resilient backends and eliminate manual, error-prone tasks."
				image={feature04}
				link="/portfolio"
			/>
			<Card
				title="Sustainable Innovation"
				subtitle="Applying engineering logic not just to software, but to hardware ventures like Photovoltaic Data and PLA 3D Printing."
				image={feature05}
				link="/portfolio"
			/>
		</Col>
	</Row>
</Section>
